{
  "name": "@qeet-id/react",
  "version": "0.1.0",
  "description": "React hooks and prebuilt components for Qeet ID — the passkeys-first identity platform.",
  "license": "MIT",
  "author": "Qeet Group",
  "homepage": "https://github.com/qeetgroup/qeet-id-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeet-id-react.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeet-id-react/issues"
  },
  "keywords": [
    "qeet",
    "identity",
    "auth",
    "authentication",
    "react",
    "hooks",
    "passkeys",
    "webauthn",
    "sdk"
  ],
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/qeet-id-react.cjs",
  "module": "./dist/qeet-id-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/qeet-id-react.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/qeet-id-react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --diagnostic-level=error .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "biome check --diagnostic-level=error .",
    "prepublishOnly": "bun run verify",
    "verify": "bun run typecheck && bun run check && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@microsoft/api-extractor": "^7.59.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
