{
  "name": "@qeet-id/react",
  "version": "0.1.0",
  "description": "React hooks and prebuilt components for Qeet ID — the passkeys-first identity platform.",
  "license": "MIT",
  "author": "Qeet Group",
  "homepage": "https://github.com/qeetgroup/qeet-id-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeet-id-react.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeet-id-react/issues"
  },
  "keywords": ["qeet", "identity", "auth", "authentication", "react", "hooks", "passkeys", "webauthn", "sdk"],
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18.17"
  },
  "sideEffects": false,
  "main": "./dist/qeet-id-react.cjs",
  "module": "./dist/qeet-id-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/qeet-id-react.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/qeet-id-react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE", "README.md", "CHANGELOG.md"],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
