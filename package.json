{
  "name": "@qeet-id/react",
  "version": "0.1.0",
  "description": "React provider, hooks and components for Qeet ID: people sign in on Qeet ID's hosted pages, and the session lives on your own server.",
  "license": "MIT",
  "author": "Qeet Group",
  "homepage": "https://github.com/qeetgroup/qeet-id-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeet-id-react.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeet-id-react/issues"
  },
  "keywords": [
    "qeet",
    "qeet-id",
    "identity",
    "authentication",
    "authorization",
    "oidc",
    "react",
    "hooks",
    "session",
    "backend-for-frontend",
    "multi-tenant",
    "sdk"
  ],
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "contract": [
        "./dist/contract.d.cts"
      ],
      "testing": [
        "./dist/testing.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --diagnostic-level=error .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --diagnostic-level=error .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint --strict && attw --pack . --exclude-entrypoints ./styles.css",
    "verify": "bun run typecheck && bun run check && bun run test && bun run build && bun run check:package",
    "prepublishOnly": "bun run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
